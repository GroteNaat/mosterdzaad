# Kopieer naar .env. Gebruik twee verschillende willekeurige waarden (openssl rand -hex 32).
SECRET_KEY=
POSTGRES_PASSWORD=
# Publiceer de webapp op alle IPv4-netwerkinterfaces van je Docker-host.
# Open http://<LAN-IP-van-je-server>:8000 vanaf je thuisnetwerk.
BIND_ADDRESS=0.0.0.0
PORT=8000
# Accepteer het IP of de hostnaam waarmee je je homelab benadert.
# Eventueel beperken: localhost,127.0.0.1,192.168.1.20,homelab.local
# Dit controleert de servernaam, niet welke apparaten toegang hebben.
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
HTTPS=false
TRUST_PROXY=false
APP_VERSION=local
