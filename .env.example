# Kopieer naar .env. Gebruik twee verschillende willekeurige waarden (openssl rand -hex 32).
SECRET_KEY=
POSTGRES_PASSWORD=
# Veilig standaard: alleen via de Ubuntu-server zelf / SSH-tunnel bereikbaar.
BIND_ADDRESS=127.0.0.1
PORT=8000
# Voeg bij LAN-gebruik het lokale IP of de hostnaam van je server toe.
# Behoud 127.0.0.1 voor de container-healthcheck.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
HTTPS=false
TRUST_PROXY=false
APP_VERSION=local
